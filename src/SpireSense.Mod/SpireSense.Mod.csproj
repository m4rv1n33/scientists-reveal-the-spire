<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>SpireSense.Mod</AssemblyName>
    <RootNamespace>SpireSense.Mod</RootNamespace>
    <IsWindows>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))</IsWindows>
    <IsMacOS>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))</IsMacOS>
    <IsLinux>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))</IsLinux>
    <ProcessArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</ProcessArchitecture>

    <SteamAppName>Slay the Spire 2</SteamAppName>

    <!--
      Defaults assume the game sits in the default Steam library.
      Override SteamCommonDir in Directory.Build.props.user or via -p:SteamCommonDir=...
    -->
    <SteamCommonDir Condition="'$(SteamCommonDir)' == '' and '$(IsWindows)' == 'True'">$(MSBuildProgramFiles32)\Steam\steamapps\common\$(SteamAppName)</SteamCommonDir>
    <SteamCommonDir Condition="'$(SteamCommonDir)' == '' and '$(IsMacOS)' == 'True'">$(HOME)/Library/Application Support/Steam/steamapps/common/$(SteamAppName)</SteamCommonDir>
    <SteamCommonDir Condition="'$(SteamCommonDir)' == '' and '$(IsLinux)' == 'True'">$(HOME)/.local/share/Steam/steamapps/common/$(SteamAppName)</SteamCommonDir>

    <SteamManagedDir Condition="'$(SteamManagedDir)' == '' and '$(IsWindows)' == 'True'">$(SteamCommonDir)\data_sts2_windows_x86_64</SteamManagedDir>
    <SteamManagedDir Condition="'$(SteamManagedDir)' == '' and '$(IsLinux)' == 'True'">$(SteamCommonDir)/data_sts2_linuxbsd_x86_64</SteamManagedDir>
    <SteamManagedDir Condition="'$(SteamManagedDir)' == '' and '$(IsMacOS)' == 'True' and '$(ProcessArchitecture)' == 'Arm64'">$(SteamCommonDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</SteamManagedDir>
    <SteamManagedDir Condition="'$(SteamManagedDir)' == '' and '$(IsMacOS)' == 'True' and '$(ProcessArchitecture)' == 'X64'">$(SteamCommonDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</SteamManagedDir>
    <SteamManagedDir Condition="'$(SteamManagedDir)' == '' and '$(IsMacOS)' == 'True'">$(SteamCommonDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</SteamManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(SteamManagedDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(SteamManagedDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SteamManagedDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="SpireSense.Mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpireSense.GameSense\SpireSense.GameSense.csproj" />
  </ItemGroup>

</Project>
